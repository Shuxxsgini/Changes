"""
Fake notification provider: stands in for an outside email/SMS service. NOT part of our app.

Student notes:
- It runs as its own container (`provider` in docker-compose.yml). Our API calls it over
  HTTP at http://provider:9000, as it would call a real provider on the internet.
- Switch its MODE to see how our API copes, at http://localhost:9000/docs or with curl:
      curl -X PUT localhost:9000/mode/fail
    ok    answers 200 at once
    fail  answers 503 at once
    slow  answers after 10 seconds (longer than our API is willing to wait)
  `docker compose stop provider` is a fourth case: nobody answers at all.
- Week 4: the same mode also controls POST /pay (fake card payments):
    ok -> payment accepted, fail -> payment refused, slow -> payment times out
- The mode lives in memory: after a restart it's "ok" again.
"""

import asyncio
from typing import Literal

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel

app = FastAPI(title="Fake Notification Provider")
mode = "ok"


class Payment(BaseModel):
    """A card payment request from our API (Week 4): who pays, and how much."""

    user_id: int
    amount: str  # sent as text, e.g. "1100.00"


class Notification(BaseModel):
    to: str
    message: str


@app.post("/notify")
async def notify(notification: Notification):
    """'Send' a notification. What happens depends on the mode."""
    if mode == "fail":
        raise HTTPException(503, "Provider is down (mode=fail)")
    if mode == "slow":
        await asyncio.sleep(10)
    print(f"SENT to {notification.to}: {notification.message}", flush=True)
    return {"status": "sent"}


@app.post("/pay")
async def pay(payment: Payment):
    """Week 4: fake card payment gateway. Follows the SAME mode as notifications:
    ok -> paid, fail -> 503 (payment refused), slow -> too slow (our API gives up)."""
    if mode == "fail":
        raise HTTPException(503, "Payment gateway is down (mode=fail)")
    if mode == "slow":
        await asyncio.sleep(10)
    print(f"PAID by user {payment.user_id}: Rs{payment.amount}", flush=True)
    return {"status": "paid"}


@app.put("/mode/{new_mode}")
async def set_mode(new_mode: Literal["ok", "fail", "slow"]):
    """Switch mode: ok, fail or slow."""
    global mode
    mode = new_mode
    return {"mode": mode}




