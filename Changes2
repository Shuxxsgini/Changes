"""Check and order rules"""

from decimal import Decimal

from sqlalchemy.orm import Session

from app.repositories import cart_repository, order_repository
from app.services import payment_service
from app.utils.exceptions import BusinessRuleError, NotFoundError


def checkout(db: Session, user_id: int, data):
    items = cart_repository.get_cart_items(db, user_id)
    if not items:
        raise BusinessRuleError("Your cart is empty.")

    # checking everything before changing anything
    for item in items:
        if not item.product.is_active:
            raise BusinessRuleError(f"'{item.product.product_name}' is no longer available.")
        if item.quantity > item.product.available_quantity:
            raise BusinessRuleError(f" Only {item.product.available_quantity} '{item.product.product_name}' in stock")

    # total amt calulated by the server
    total = sum((item.product.price * item.quantity for item in items), Decimal("0"))

    # Week 4: card orders are paid BEFORE anything is saved.
    # If the gateway refuses, charge() raises -> no order, stock and cart untouched.
    if data.payment_method == "CREDIT_CARD":
        payment_service.charge(user_id, total)

    # Creating the order: each lines create price paid today
    lines = [{"product_id": item.product_id, "quantity": item.quantity, "price": item.product.price} for item in items]

    order = order_repository.create_order(db, user_id, data.payment_method, total, lines)

    # reducing stock and emptying the cart
    for item in items:
        item.product.available_quantity -= item.quantity
        cart_repository.delete_cart_item(db, item)

    db.commit()
    db.refresh(order)
    return order


async def order_history_async(db, user_id: int):
    return await order_repository.get_orders_by_user_async(db, user_id)


def order_details(db: Session, user_id: int, order_id: int):
    order = order_repository.get_order_by_id(db, order_id)
    if order is None or order.user_id != user_id:
        raise NotFoundError("Order not found.")
    return order


def all_orders(db: Session):
    return order_repository.get_all_orders(db)


def cancel_order(db: Session, user_id: int, order_id: int):
    order = order_details(db, user_id, order_id)

    if order.status == "cancelled":
        raise BusinessRuleError("Order is already cancelled.")

    for line in order.details:
        line.product.available_quantity += line.quantity

    order.status = "cancelled"
    db.commit()
    db.refresh(order)
    return order




