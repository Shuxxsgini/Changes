    monkeypatch.setattr(payment_service, "charge", lambda user_id, amount: charged.append(amount))

    client.post("/api/cart/add", json={"product_id": 1, "quantity": 1}, headers=auth_headers)
    r = client.post("/api/orders/checkout", json={"payment_method": "CREDIT_CARD"}, headers=auth_headers)

    assert r.status_code == 201
