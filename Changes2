def test_card_payment_refused_creates_no_order(client, auth_headers, monkeypatch):
    def gateway_down(user_id, amount):
        raise PaymentFailedError("Payment failed")

    monkeypatch.setattr(payment_service, "charge", gateway_down)

    client.post("/api/cart/add", json={"product_id": 1, "quantity": 1}, headers=auth_headers)
    r = client.post("/api/orders/checkout", json={"payment_method": "CREDIT_CARD"}, headers=auth_headers)

