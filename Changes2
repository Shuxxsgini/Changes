"""Week 4: fake card payments through the provider container (POST /pay).

Student notes:
- Only CREDIT_CARD orders are charged. CASH_ON_DELIVERY is paid later, at the door.
- Switch the provider's mode to see what happens (http://localhost:9000/docs):
    ok    -> payment accepted, the order is placed
    fail  -> payment refused, NO order is created, the cart stays as it was
    slow  -> we stop waiting after TIMEOUT_SECONDS: payment failed
- Unlike notifications, a failed payment MUST stop the checkout, so this one raises.
- It's a normal (sync) function because checkout is a normal (sync) endpoint.
"""

import logging
from decimal import Decimal

import httpx

from app.core.config import settings
from app.utils.exceptions import PaymentFailedError

logger = logging.getLogger(__name__)

TIMEOUT_SECONDS = 2  # never wait longer than this for the gateway

# Same provider as notifications, different path: ".../notify" -> ".../pay"
PAY_URL = settings.notification_provider_url.rsplit("/", 1)[0] + "/pay"


def charge(user_id: int, amount: Decimal) -> None:
    """Ask the gateway to take `amount`. Returns if paid, raises PaymentFailedError if not."""
    try:
        response = httpx.post(PAY_URL, json={"user_id": user_id, "amount": str(amount)}, timeout=TIMEOUT_SECONDS)
        response.raise_for_status()  # 4xx / 5xx -> HTTPStatusError
    except httpx.HTTPError as exc:  # covers bad status, timeout and "nobody answered"
        logger.warning("Payment of Rs%s by user %s FAILED (%s)", amount, user_id, type(exc).__name__)
        raise PaymentFailedError(
            "Payment failed: the card payment could not be completed. "
            "Please try again or choose Cash on Delivery."
        ) from exc

    logger.info("Payment of Rs%s by user %s accepted", amount, user_id)



