A22. frontend/src/pages/RegisterPage.jsx

import { useState } from "react";
import { Link, useNavigate } from "react-router-dom";

import FormInput from "../components/common/FormInput.jsx";
import AlertMessage from "../components/common/AlertMessage.jsx";
import { useForm } from "../hooks/useForm.js";
import { validateRegisterForm } from "../utils/validators.js";
import { registerUser } from "../services/authService.js";
import { useToast } from "../context/ToastContext.jsx";

// Blank form (also what Reset goes back to)
const INITIAL_VALUES = { name: "", email: "", mobile: "", password: "" };

// Milestone 1: Registration with validations
function RegisterPage() {
  const navigate = useNavigate();
  const { showToast } = useToast();
  const { values, isValid, handleChange, handleBlur, touchAll, reset, errorFor } = useForm(
    INITIAL_VALUES,
    validateRegisterForm
  );
  const [submitting, setSubmitting] = useState(false); // true while the request runs
  const [serverError, setServerError] = useState(""); // message from the backend

  const handleSubmit = async (event) => {
    event.preventDefault(); // no page reload
    touchAll(); // show every field's error
    if (!isValid) return; // stop if anything is invalid

    setSubmitting(true);
    setServerError("");
    try {
      await registerUser({
        name: values.name.trim(),
        email: values.email.trim(),
        mobile: values.mobile.trim(),
        password: values.password,
      });
      // Pop-up, then go to Login
      showToast("Registration successful! Please log in.", "success");
      navigate("/login");
    } catch (error) {
      setServerError(error.message); // e.g. "Email is already Registered."
      showToast(error.message, "danger");
      setSubmitting(false);
    }
  };

  const handleReset = () => {
    reset();
    setServerError("");
  };

  return (
    <div className="row justify-content-center">
      <div className="col-md-8 col-lg-5">
        <div className="card border-0 shadow-sm">
          <div className="card-body p-4 p-md-5">
            <div className="text-center mb-4">
              <i className="bi bi-person-plus-fill display-6 text-warning"></i>
              <h1 className="h3 fw-bold mt-2">Create your account</h1>
              <p className="text-secondary small mb-0">Join ABC Shop in less than a minute.</p>
            </div>

            <AlertMessage type="danger" message={serverError} />

            {/* noValidate: our messages instead of the browser's */}
            <form onSubmit={handleSubmit} noValidate>
              <FormInput label="Full Name" name="name" icon="bi-person" value={values.name}
                onChange={handleChange} onBlur={handleBlur} error={errorFor("name")} autoComplete="name" />
              <FormInput label="Email address" name="email" type="email" icon="bi-envelope" value={values.email}
                onChange={handleChange} onBlur={handleBlur} error={errorFor("email")} autoComplete="email" />
              <FormInput label="Mobile number" name="mobile" type="tel" icon="bi-phone" value={values.mobile}
                onChange={handleChange} onBlur={handleBlur} error={errorFor("mobile")}
                hint="10 digits, e.g. 9876543210" autoComplete="tel" />
              <FormInput label="Password" name="password" type="password" icon="bi-lock" value={values.password}
                onChange={handleChange} onBlur={handleBlur} error={errorFor("password")}
                hint="8–25 characters with an uppercase letter, a lowercase letter, a number, and a special character."
                autoComplete="new-password" />

              <div className="d-flex gap-2 mt-4">
                {/* Enabled only when every field is valid; disabled while sending */}
                <button type="submit" className="btn btn-warning fw-semibold flex-grow-1" disabled={!isValid || submitting}>
                  {submitting ? (
                    <><span className="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Registering...</>
                  ) : (
                    "Register"
                  )}
                </button>
                <button type="button" className="btn btn-outline-secondary" onClick={handleReset} disabled={submitting}>
                  Reset
                </button>
              </div>
            </form>

            <p className="text-center small mt-4 mb-0">
              Already have an account? <Link to="/login" className="fw-semibold">Login</Link>
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}

export default RegisterPage;




A23. frontend/src/pages/LoginPage.jsx

import { useState } from "react";
import { Link, useLocation, useNavigate } from "react-router-dom";

import FormInput from "../components/common/FormInput.jsx";
import AlertMessage from "../components/common/AlertMessage.jsx";
import { useForm } from "../hooks/useForm.js";
import { validateLoginForm } from "../utils/validators.js";
import { useAuth } from "../context/AuthContext.jsx";
import { useToast } from "../context/ToastContext.jsx";

const INITIAL_VALUES = { email: "", password: "" };

// Milestone 1: Login with validations (works for customer, admin and support)
function LoginPage() {
  const navigate = useNavigate();
  const location = useLocation();
  const { login } = useAuth();
  const { showToast } = useToast();

  const { values, isValid, handleChange, handleBlur, touchAll, reset, errorFor } = useForm(
    INITIAL_VALUES,
    validateLoginForm
  );
  const [submitting, setSubmitting] = useState(false);
  const [serverError, setServerError] = useState("");

  // Sent by other pages: why we're here, and where to go after login
  const infoMessage = location.state?.message ?? "";
  const redirectTo = location.state?.from ?? "/";

  const handleSubmit = async (event) => {
    event.preventDefault();
    touchAll();
    if (!isValid) return;

    setSubmitting(true);
    setServerError("");
    try {
      const me = await login(values.email.trim(), values.password);
      showToast(`Welcome back, ${me.name}!`, "success");
      navigate(redirectTo, { replace: true });
    } catch (error) {
      setServerError(error.message); // e.g. "Invalid email or password."
      showToast(error.message, "danger");
      setSubmitting(false);
    }
  };

  const handleReset = () => {
    reset();
    setServerError("");
  };

  return (
    <div className="row justify-content-center">
      <div className="col-md-8 col-lg-5">
        <div className="card border-0 shadow-sm">
          <div className="card-body p-4 p-md-5">
            <div className="text-center mb-4">
              <i className="bi bi-box-arrow-in-right display-6 text-warning"></i>
              <h1 className="h3 fw-bold mt-2">Welcome back</h1>
              <p className="text-secondary small mb-0">Log in to continue shopping.</p>
            </div>

            <AlertMessage type="info" message={infoMessage} />
            <AlertMessage type="danger" message={serverError} />

            <form onSubmit={handleSubmit} noValidate>
              <FormInput label="Email address" name="email" type="email" icon="bi-envelope" value={values.email}
                onChange={handleChange} onBlur={handleBlur} error={errorFor("email")} autoComplete="email" />
              <FormInput label="Password" name="password" type="password" icon="bi-lock" value={values.password}
                onChange={handleChange} onBlur={handleBlur} error={errorFor("password")} autoComplete="current-password" />

              <div className="d-flex gap-2 mt-4">
                <button type="submit" className="btn btn-warning fw-semibold flex-grow-1" disabled={!isValid || submitting}>
                  {submitting ? (
                    <><span className="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Logging in...</>
                  ) : (
                    "Login"
                  )}
                </button>
                <button type="button" className="btn btn-outline-secondary" onClick={handleReset} disabled={submitting}>
                  Reset
                </button>
              </div>
            </form>

            <p className="text-center small mt-4 mb-0">
              Don&apos;t have an account? <Link to="/register" className="fw-semibold">Register</Link>
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}

export default LoginPage;



