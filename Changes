A16. frontend/src/components/products/SearchBar.jsx

import PropTypes from "prop-types";

// Search box with a magnifying-glass icon. The page owns the text (value) and gets each change (onChange).
function SearchBar({ value, onChange }) {
  return (
    <div className="input-group input-group-lg shadow-sm mb-4">
      <span className="input-group-text bg-white border-end-0">
        <i className="bi bi-search text-secondary"></i>
      </span>
      <input
        type="search"
        className="form-control border-start-0"
        placeholder="Search by product name or category..."
        aria-label="Search products"
        value={value}
        onChange={(event) => onChange(event.target.value)}
      />
    </div>
  );
}

SearchBar.propTypes = {
  value: PropTypes.string.isRequired,
  onChange: PropTypes.func.isRequired,
};

export default SearchBar;





A17. frontend/src/components/products/ProductCard.jsx

import { Link } from "react-router-dom";
import PropTypes from "prop-types";

import { iconFor, imageFor } from "../../utils/productImages.js";

// One product card: picture, category, name, price, stock, Add to Cart (+ count badge)
function ProductCard({ product, onAddToCart, addedCount = 0 }) {
  const inStock = product.available_quantity > 0;
  const image = imageFor(product.product_name);
  const detailsUrl = `/products/${product.product_id}`;

  return (
    // h-100 = all cards in a row have the same height. card-hover = lifts on mouse-over
    <div className="card h-100 border-0 shadow-sm card-hover overflow-hidden">
      {/* Picture (or a grey box with an icon) links to the details page */}
      <Link to={detailsUrl}>
        {image ? (
          <img src={image} alt={product.product_name} className="card-img-top product-image" />
        ) : (
          <div className="image-placeholder bg-light d-flex align-items-center justify-content-center text-secondary">
            <i className={`bi ${iconFor(product.category.category_name)}`}></i>
          </div>
        )}
      </Link>

      <div className="card-body d-flex flex-column">
        <span className="badge text-bg-light border align-self-start mb-2">{product.category.category_name}</span>

        <h5 className="card-title h6 mb-2">
          <Link to={detailsUrl} className="text-dark text-decoration-none">
            {product.product_name}
          </Link>
        </h5>

        {/* mt-auto pushes price + button to the bottom of the card */}
        <div className="mt-auto">
          <div className="d-flex justify-content-between align-items-center mb-3">
            <span className="fs-5 fw-bold">₹{product.price}</span>
            <small className={inStock ? "text-success" : "text-danger"}>
              <i className={`bi ${inStock ? "bi-check-circle" : "bi-x-circle"} me-1`}></i>
              {inStock ? `${product.available_quantity} in stock` : "Out of stock"}
            </small>
          </div>

          {inStock ? (
            <div className="d-flex align-items-center gap-2">
              <button type="button" className="btn btn-warning fw-semibold flex-grow-1" onClick={() => onAddToCart(product)}>
                <i className="bi bi-cart-plus me-1"></i>Add to Cart
              </button>
              {/* +1, +2... after each successful add */}
              {addedCount > 0 && <span className="badge rounded-pill text-bg-success fs-6">+{addedCount}</span>}
            </div>
          ) : (
            <button type="button" className="btn btn-secondary w-100" disabled>
              Out of Stock
            </button>
          )}
        </div>
      </div>
    </div>
  );
}

ProductCard.propTypes = {
  product: PropTypes.shape({
    product_id: PropTypes.number.isRequired,
    product_name: PropTypes.string.isRequired,
    price: PropTypes.oneOfType([PropTypes.string, PropTypes.number]).isRequired,
    available_quantity: PropTypes.number.isRequired,
    category: PropTypes.shape({ category_name: PropTypes.string.isRequired }).isRequired,
  }).isRequired,
  onAddToCart: PropTypes.func.isRequired,
  addedCount: PropTypes.number,
};

export default ProductCard;




A18. frontend/src/components/cart/CartItemRow.jsx

import { useState } from "react";
import PropTypes from "prop-types";

import { validateQuantity } from "../../utils/validators.js";
import { iconFor, imageFor } from "../../utils/productImages.js";

/**
 * One item in the cart: picture, name, price, quantity box, subtotal, Update, Remove.
 * The row only checks the quantity; CartPage does the saving (onUpdate / onRemove).
 */
function CartItemRow({ item, stock, onUpdate, onRemove }) {
  // What the user is typing (text), before clicking Update
  const [quantity, setQuantity] = useState(String(item.quantity));

  const error = validateQuantity(quantity, stock); // "" when valid
  const changed = Number(quantity) !== item.quantity; // did the number change?
  const subtotal = (Number(item.product.price) * item.quantity).toFixed(2);
  const image = imageFor(item.product.product_name);

  return (
    // list-group-item = one row in a Bootstrap list
    <div className="list-group-item py-3">
      <div className="row g-3 align-items-center">
        {/* Picture + name + price */}
        <div className="col-md-5 d-flex align-items-center gap-3">
          {image ? (
            <img src={image} alt="" className="thumb rounded border" />
          ) : (
            <span className="thumb rounded border bg-light d-flex align-items-center justify-content-center text-secondary">
              <i className={`bi ${iconFor("")}`}></i>
            </span>
          )}
          <div>
            <div className="fw-semibold">{item.product.product_name}</div>
            <small className="text-secondary">₹{item.product.price} each</small>
          </div>
        </div>

        {/* Quantity box + Update */}
        <div className="col-7 col-md-4">
          <div className="input-group input-group-sm has-validation">
            <input
              type="number"
              min="1"
              max={stock}
              aria-label={`Quantity of ${item.product.product_name}`}
              className={`form-control ${error ? "is-invalid" : ""}`}
              value={quantity}
              onChange={(event) => setQuantity(event.target.value)}
            />
            {/* Disabled while the quantity is invalid or unchanged */}
            <button
              type="button"
              className="btn btn-outline-dark"
              disabled={Boolean(error) || !changed}
              onClick={() => onUpdate(item.cart_item_id, Number(quantity))}
            >
              Update
            </button>
            {error && <div className="invalid-feedback">{error}</div>}
          </div>
        </div>

        {/* Subtotal + Remove */}
        <div className="col-5 col-md-3 d-flex align-items-center justify-content-end gap-3">
          <span className="fw-bold">₹{subtotal}</span>
          <button
            type="button"
            className="btn btn-sm btn-outline-danger"
            aria-label={`Remove ${item.product.product_name}`}
            onClick={() => onRemove(item.cart_item_id)}
          >
            <i className="bi bi-trash"></i>
          </button>
        </div>
      </div>
    </div>
  );
}

CartItemRow.propTypes = {
  item: PropTypes.shape({
    cart_item_id: PropTypes.number.isRequired,
    quantity: PropTypes.number.isRequired,
    product: PropTypes.shape({
      product_name: PropTypes.string.isRequired,
      price: PropTypes.oneOfType([PropTypes.string, PropTypes.number]).isRequired,
    }).isRequired,
  }).isRequired,
  stock: PropTypes.number.isRequired,
  onUpdate: PropTypes.func.isRequired,
  onRemove: PropTypes.func.isRequired,
};

export default CartItemRow;




