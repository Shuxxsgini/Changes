A25. frontend/src/pages/ProductListPage.jsx

import { useEffect, useState } from "react";
import { useNavigate, useSearchParams } from "react-router-dom";

import SearchBar from "../components/products/SearchBar.jsx";
import ProductCard from "../components/products/ProductCard.jsx";
import AlertMessage from "../components/common/AlertMessage.jsx";
import Loader from "../components/common/Loader.jsx";
import { getProducts } from "../services/productService.js";
import { addToCart } from "../services/cartService.js";
import { useAuth } from "../context/AuthContext.jsx";
import { useToast } from "../context/ToastContext.jsx";

// Milestones 2 + 3: product list, search by name/category, Add to Cart
function ProductListPage() {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams(); // reads ?category=Books from the Home page tiles
  const { isLoggedIn } = useAuth();
  const { showToast } = useToast();

  const [products, setProducts] = useState(null); // null = still loading
  const [searchText, setSearchText] = useState(searchParams.get("category") ?? "");
  const [error, setError] = useState("");
  const [addedCounts, setAddedCounts] = useState({}); // { product_id: times added }

  // Load all products once
  useEffect(() => {
    getProducts()
      .then((data) => setProducts(Array.isArray(data) ? data : []))
      .catch((err) => setError(err.message));
  }, []);

  const handleAddToCart = async (product) => {
    if (!isLoggedIn) {
      navigate("/login", { state: { from: "/products", message: "Please log in to add items to your cart." } });
      return;
    }
    try {
      await addToCart(product.product_id, 1); // POST /api/cart/add
      setAddedCounts((prev) => ({ ...prev, [product.product_id]: (prev[product.product_id] ?? 0) + 1 }));
      showToast(`${product.product_name} was added to your cart.`, "success");
    } catch (err) {
      showToast(err.message, "danger"); // e.g. "Only 5 'Apron' in stock."
    }
  };

  // Loading failed → error; still loading → spinner
  if (error) return <AlertMessage type="danger" message={error} />;
  if (!products) return <Loader text="Loading products..." />;

  // Search: keep products whose name OR category contains the typed text
  const search = searchText.trim().toLowerCase();
  const filteredProducts = products.filter(
    (product) =>
      product.product_name.toLowerCase().includes(search) ||
      product.category.category_name.toLowerCase().includes(search)
  );

  return (
    <>
      <div className="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
          <h1 className="h3 fw-bold mb-0">Products</h1>
          <p className="text-secondary mb-0">
            {filteredProducts.length} of {products.length} products
          </p>
        </div>
      </div>

      <SearchBar value={searchText} onChange={setSearchText} />

      {filteredProducts.length === 0 ? (
        <div className="text-center py-5 bg-white rounded-3 shadow-sm">
          <i className="bi bi-search display-5 text-secondary"></i>
          <p className="mt-3 mb-0">No products found.</p>
        </div>
      ) : (
        // 1 card per row on phones, 2 on tablets, 3 on laptops, 4 on wide screens
        <div className="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
          {filteredProducts.map((product) => (
            <div className="col" key={product.product_id}>
              <ProductCard
                product={product}
                onAddToCart={handleAddToCart}
                addedCount={addedCounts[product.product_id] ?? 0}
              />
            </div>
          ))}
        </div>
      )}
    </>
  );
}

export default ProductListPage;


A26. frontend/src/pages/ProductDetailsPage.jsx

import { useEffect, useState } from "react";
import { Link, useNavigate, useParams } from "react-router-dom";

import AlertMessage from "../components/common/AlertMessage.jsx";
import Loader from "../components/common/Loader.jsx";
import { getProductById } from "../services/productService.js";
import { addToCart } from "../services/cartService.js";
import { useAuth } from "../context/AuthContext.jsx";
import { useToast } from "../context/ToastContext.jsx";
import { iconFor, imageFor } from "../utils/productImages.js";

// Milestone 2 + 3: one product, with Add to Cart
function ProductDetailsPage() {
  const { productId } = useParams(); // the ":productId" part of the URL
  const navigate = useNavigate();
  const { isLoggedIn } = useAuth();
  const { showToast } = useToast();

  const [product, setProduct] = useState(null);
  const [error, setError] = useState("");

  useEffect(() => {
    getProductById(productId)
      .then((data) => setProduct(data))
      .catch((err) => setError(err.message)); // e.g. "Product not found."
  }, [productId]);

  const handleAddToCart = async () => {
    if (!isLoggedIn) {
      navigate("/login", { state: { from: `/products/${productId}`, message: "Please log in to add items to your cart." } });
      return;
    }
    try {
      await addToCart(product.product_id, 1);
      showToast(`${product.product_name} was added to your cart.`, "success");
    } catch (err) {
      showToast(err.message, "danger");
    }
  };

  if (error) return <AlertMessage type="danger" message={error} />;
  if (!product) return <Loader text="Loading product..." />;

  const inStock = product.available_quantity > 0;
  const image = imageFor(product.product_name);

  return (
    <>
      {/* Breadcrumb: Products > Apron */}
      <nav aria-label="breadcrumb">
        <ol className="breadcrumb">
          <li className="breadcrumb-item"><Link to="/products">Products</Link></li>
          <li className="breadcrumb-item active" aria-current="page">{product.product_name}</li>
        </ol>
      </nav>

      <div className="card border-0 shadow-sm">
        <div className="row g-0">
          {/* Picture */}
          <div className="col-md-5 border-end d-flex align-items-center justify-content-center bg-white rounded-start p-3">
            {image ? (
              <img src={image} alt={product.product_name} className="img-fluid" style={{ maxHeight: "360px" }} />
            ) : (
              <i className={`bi ${iconFor(product.category.category_name)} text-secondary`} style={{ fontSize: "6rem" }}></i>
            )}
          </div>

          {/* Details */}
          <div className="col-md-7">
            <div className="card-body p-4 p-md-5">
              <span className="badge text-bg-light border mb-2">{product.category.category_name}</span>
              <h1 className="h2 fw-bold">{product.product_name}</h1>
              <p className="display-6 fw-bold my-3">₹{product.price}</p>
              <p className="text-secondary">{product.description || "No description available."}</p>

              <p className={`fw-semibold ${inStock ? "text-success" : "text-danger"}`}>
                <i className={`bi ${inStock ? "bi-check-circle" : "bi-x-circle"} me-1`}></i>
                {inStock ? `In stock: ${product.available_quantity}` : "Out of Stock"}
              </p>

              <div className="d-flex flex-wrap gap-2 mt-4">
                <button type="button" className="btn btn-warning btn-lg fw-semibold" disabled={!inStock} onClick={handleAddToCart}>
                  <i className="bi bi-cart-plus me-2"></i>
                  {inStock ? "Add to Cart" : "Out of Stock"}
                </button>
                <Link to="/products" className="btn btn-outline-dark btn-lg">
                  Continue shopping
                </Link>
              </div>
            </div>
          </div>
        </div>
      </div>
    </>
  );
}

export default ProductDetailsPage;




A27. frontend/src/pages/CartPage.jsx

import { useCallback, useEffect, useState } from "react";
import { Link, useNavigate } from "react-router-dom";

import CartItemRow from "../components/cart/CartItemRow.jsx";
import AlertMessage from "../components/common/AlertMessage.jsx";
import Loader from "../components/common/Loader.jsx";
import { getCartItems, getCartSummary, removeCartItem, updateCartItem } from "../services/cartService.js";
import { getProducts } from "../services/productService.js";
import { useToast } from "../context/ToastContext.jsx";

// Milestone 3: cart (view, update quantity, remove, total, checkout)
function CartPage() {
  const navigate = useNavigate();
  const { showToast } = useToast();

  const [items, setItems] = useState([]);
  const [summary, setSummary] = useState(null); // null until the backend answers
  const [stockById, setStockById] = useState({}); // { product_id: available_quantity }
  const [error, setError] = useState("");

  // Load the cart, the totals and the stock together (3 requests at once)
  const loadCart = useCallback(async () => {
    try {
      const [cartItems, cartSummary, products] = await Promise.all([
        getCartItems(),
        getCartSummary(),
        getProducts(),
      ]);
      const stock = {};
      products.forEach((product) => {
        stock[product.product_id] = product.available_quantity;
      });
      setItems(cartItems);
      setSummary(cartSummary);
      setStockById(stock);
    } catch (err) {
      setError(err.message);
    }
  }, []);

  useEffect(() => {
    loadCart();
  }, [loadCart]);

  // After each change we reload, so the total updates automatically
  const handleUpdate = async (cartItemId, quantity) => {
    try {
      await updateCartItem(cartItemId, quantity);
      await loadCart();
      showToast("Quantity updated.", "success");
    } catch (err) {
      showToast(err.message, "danger");
    }
  };

  const handleRemove = async (cartItemId) => {
    try {
      await removeCartItem(cartItemId);
      await loadCart();
      showToast("Item removed from your cart.", "info");
    } catch (err) {
      showToast(err.message, "danger");
    }
  };

  if (error && !summary) return <AlertMessage type="danger" message={error} />;
  if (!summary) return <Loader text="Loading your cart..." />;

  // Empty cart: friendly message
  if (items.length === 0) {
    return (
      <div className="text-center py-5 bg-white rounded-3 shadow-sm">
        <i className="bi bi-cart-x display-4 text-secondary"></i>
        <h1 className="h4 fw-bold mt-3">Your cart is empty.</h1>
        <p className="text-secondary">Find something you like and add it here.</p>
        <Link to="/products" className="btn btn-warning fw-semibold">Browse products</Link>
      </div>
    );
  }

  return (
    <>
      <h1 className="h3 fw-bold mb-3">
        <i className="bi bi-cart3 me-2"></i>Your Cart
      </h1>

      <div className="row g-4">
        {/* Left: the items */}
        <div className="col-lg-8">
          <div className="card border-0 shadow-sm">
            <div className="list-group list-group-flush">
              {items.map((item) => (
                <CartItemRow
                  key={item.cart_item_id}
                  item={item}
                  stock={stockById[item.product.product_id] ?? 0}
                  onUpdate={handleUpdate}
                  onRemove={handleRemove}
                />
              ))}
            </div>
          </div>
        </div>

        {/* Right: order summary (numbers come from /api/cart/summary) */}
        <div className="col-lg-4">
          <div className="card border-0 shadow-sm">
            <div className="card-body">
              <h2 className="h5 fw-bold mb-3">Order summary</h2>
              <div className="d-flex justify-content-between mb-2">
                <span className="text-secondary">Items</span>
                <span>{summary.total_quantity}</span>
              </div>
              <div className="d-flex justify-content-between mb-2">
                <span className="text-secondary">Delivery</span>
                <span className="text-success">Free</span>
              </div>
              <hr />
              <div className="d-flex justify-content-between fs-5 fw-bold mb-3">
                <span>Total</span>
                <span>₹{summary.total_amount}</span>
              </div>
              {/* Enabled only if the cart isn't empty */}
              <button
                type="button"
                className="btn btn-warning fw-semibold w-100"
                disabled={items.length === 0}
                onClick={() => navigate("/checkout")}
              >
                Proceed to Checkout <i className="bi bi-arrow-right ms-1"></i>
              </button>
              <Link to="/products" className="btn btn-link w-100 mt-2 text-decoration-none">
                Continue shopping
              </Link>
            </div>
          </div>
        </div>
      </div>
    </>
  );
}

export default CartPage;





















































