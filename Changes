A5. frontend/src/context/ToastContext.jsx (new)
import { createContext, useCallback, useContext, useState } from "react";
import PropTypes from "prop-types";

// Pop-up messages ("toasts") that any page can show with: showToast("Saved!")
const ToastContext = createContext(null);

// An icon for each kind of message
const ICONS = {
  success: "bi-check-circle-fill",
  danger: "bi-x-circle-fill",
  info: "bi-info-circle-fill",
};

const HIDE_AFTER_MS = 3500; // each pop-up disappears by itself after 3.5 seconds

export function ToastProvider({ children }) {
  // The list of pop-ups on screen right now: [{ id, message, type }]
  const [toasts, setToasts] = useState([]);

  // Remove one pop-up (filter keeps every other one)
  const removeToast = useCallback((id) => {
    setToasts((previous) => previous.filter((toast) => toast.id !== id));
  }, []);

  // Add a pop-up. type = "success" (green), "danger" (red) or "info" (blue)
  const showToast = useCallback(
    (message, type = "success") => {
      const id = Date.now() + Math.random(); // a unique id
      setToasts((previous) => [...previous, { id, message, type }]);
      setTimeout(() => removeToast(id), HIDE_AFTER_MS); // hide it later
    },
    [removeToast]
  );

  return (
    <ToastContext.Provider value={{ showToast }}>
      {children}

      {/* Pop-ups appear in the top-right corner, on top of every page */}
      <div className="toast-container position-fixed top-0 end-0 p-3">
        {toasts.map((toast) => (
          // "toast show" = Bootstrap pop-up, already visible. text-bg-* = colour
          <div
            key={toast.id}
            className={`toast show align-items-center border-0 shadow text-bg-${toast.type}`}
            role="status"
            aria-live="polite"
          >
            <div className="d-flex">
              <div className="toast-body d-flex align-items-center gap-2">
                <i className={`bi ${ICONS[toast.type] ?? ICONS.info} fs-5`}></i>
                {toast.message}
              </div>
              {/* The × button closes it early */}
              <button
                type="button"
                className="btn-close btn-close-white me-2 m-auto"
                aria-label="Close"
                onClick={() => removeToast(toast.id)}
              ></button>
            </div>
          </div>
        ))}
      </div>
    </ToastContext.Provider>
  );
}

ToastProvider.propTypes = {
  children: PropTypes.node.isRequired,
};

// Shortcut: const { showToast } = useToast();
// eslint-disable-next-line react-refresh/only-export-components
export const useToast = () => useContext(ToastContext);




