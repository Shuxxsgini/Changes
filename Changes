A8. frontend/src/components/common/Loader.jsx

import PropTypes from "prop-types";

// A spinner in the middle of the page, with a short message under it
function Loader({ text = "Loading..." }) {
  return (
    // minHeight keeps the spinner in the middle of the content area
    <div
      className="d-flex flex-column align-items-center justify-content-center text-secondary"
      style={{ minHeight: "45vh" }}
      role="status"
    >
      {/* spinner-border = Bootstrap's spinning circle. text-warning = orange colour */}
      <div className="spinner-border text-warning" style={{ width: "3rem", height: "3rem" }} aria-hidden="true"></div>
      <span className="mt-3">{text}</span>
    </div>
  );
}

Loader.propTypes = {
  text: PropTypes.string,
};

export default Loader;





A9. frontend/src/components/common/PageTransition.jsx (new)

import { useEffect, useState } from "react";
import { useLocation } from "react-router-dom";
import PropTypes from "prop-types";

import Loader from "./Loader.jsx";

const DELAY_MS = 400; // how long the spinner shows when the page changes

/**
 * Shows the spinner for a moment every time the URL changes, then the page.
 * (Pages still show their own spinner while they wait for the backend.)
 */
function PageTransition({ children }) {
  const { pathname } = useLocation(); // e.g. "/login"
  // The page that has finished "loading". While it differs from the URL, show the spinner.
  const [readyPath, setReadyPath] = useState(null);

  // Every time the URL changes: wait DELAY_MS, then mark this page as ready
  useEffect(() => {
    const timerId = setTimeout(() => setReadyPath(pathname), DELAY_MS);
    return () => clearTimeout(timerId); // cleanup if the user moves on quickly
  }, [pathname]);

  if (readyPath !== pathname) return <Loader text="Loading page..." />;
  return children;
}

PageTransition.propTypes = {
  children: PropTypes.node.isRequired,
};

export default PageTransition;




A10. frontend/src/components/common/AlertMessage.jsx

import PropTypes from "prop-types";

// An icon for each alert colour
const ICONS = {
  success: "bi-check-circle",
  danger: "bi-exclamation-triangle",
  warning: "bi-exclamation-circle",
  info: "bi-info-circle",
};

// A coloured message box that stays on the page. Shows nothing if there's no message.
function AlertMessage({ type = "danger", message = "" }) {
  if (!message) return null;

  return (
    <div className={`alert alert-${type} d-flex align-items-center gap-2`} role="alert">
      <i className={`bi ${ICONS[type]}`}></i>
      <span>{message}</span>
    </div>
  );
}

AlertMessage.propTypes = {
  type: PropTypes.oneOf(["success", "danger", "warning", "info"]),
  message: PropTypes.string,
};

export default AlertMessage;





A11. frontend/src/components/common/FormInput.jsx

import PropTypes from "prop-types";

/**
 * One form field: label + icon + input + red error (or grey hint).
 * Used by the Register and Login forms.
 */
function FormInput({
  label,
  name,
  type = "text",
  icon = "",
  value,
  onChange,
  onBlur,
  error = "",
  hint = "",
  autoComplete = "off",
}) {
  const inputId = `field-${name}`;

  return (
    <div className="mb-3">
      <label htmlFor={inputId} className="form-label fw-semibold small">
        {label}
      </label>

      {/* input-group = icon box joined to the input. has-validation keeps the corners right with an error */}
      <div className={`input-group ${error ? "has-validation" : ""}`}>
        {icon && (
          <span className="input-group-text bg-white">
            <i className={`bi ${icon} text-secondary`}></i>
          </span>
        )}
        <input
          id={inputId}
          name={name}
          type={type}
          value={value}
          onChange={onChange}
          onBlur={onBlur}
          autoComplete={autoComplete}
          className={`form-control ${error ? "is-invalid" : ""}`} // is-invalid = red border
          aria-invalid={Boolean(error)}
          aria-describedby={`${inputId}-message`}
        />
        {/* Red message (Bootstrap shows it because the input has is-invalid) */}
        {error && (
          <div id={`${inputId}-message`} className="invalid-feedback">
            {error}
          </div>
        )}
      </div>

      {/* Grey hint, only when there's no error */}
      {!error && hint && (
        <div id={`${inputId}-message`} className="form-text">
          {hint}
        </div>
      )}
    </div>
  );
}

FormInput.propTypes = {
  label: PropTypes.string.isRequired,
  name: PropTypes.string.isRequired,
  type: PropTypes.oneOf(["text", "email", "password", "tel", "number"]),
  icon: PropTypes.string, // a Bootstrap icon class, e.g. "bi-envelope"
  value: PropTypes.string.isRequired,
  onChange: PropTypes.func.isRequired,
  onBlur: PropTypes.func.isRequired,
  error: PropTypes.string,
  hint: PropTypes.string,
  autoComplete: PropTypes.string,
};

export default FormInput;





A12. frontend/src/components/common/ProtectedRoute.jsx
import { Link, Navigate, useLocation } from "react-router-dom";
import PropTypes from "prop-types";

import Loader from "./Loader.jsx";
import { useAuth } from "../../context/AuthContext.jsx";

/**
 * Guards pages. roles (optional) = only these roles may open the page
 * (the frontend version of the backend's 403 rule).
 */
function ProtectedRoute({ children, roles = [] }) {
  const { isLoggedIn, loading, user } = useAuth();
  const location = useLocation();

  // Still checking a saved token → wait
  if (loading) return <Loader text="Checking your login..." />;

  // Not logged in → Login page, remembering where we wanted to go
  if (!isLoggedIn) {
    return <Navigate to="/login" replace state={{ from: location.pathname, message: "Please log in to continue." }} />;
  }

  // Logged in but this role isn't allowed
  if (roles.length > 0 && !roles.includes(user.role)) {
    return (
      <div className="text-center py-5">
        <i className="bi bi-shield-lock display-4 text-danger"></i>
        <h1 className="h4 mt-3">Access denied</h1>
        <p className="text-secondary">You don&apos;t have permission to view this page.</p>
        <Link to="/" className="btn btn-dark">
          Go to the home page
        </Link>
      </div>
    );
  }

  return children; // allowed → show the page
}

ProtectedRoute.propTypes = {
  children: PropTypes.node.isRequired,
  roles: PropTypes.arrayOf(PropTypes.oneOf(["customer", "admin", "support"])),
};

export default ProtectedRoute;





A13. frontend/src/components/layout/Menu.jsx

import { NavLink } from "react-router-dom";
import PropTypes from "prop-types";

import { useAuth } from "../../context/AuthContext.jsx";

// Menu links. icon = Bootstrap icon. roles = only these roles see the link.
const MENU_LINKS = [
  { path: "/", label: "Home", icon: "bi-house" },
  { path: "/products", label: "Products", icon: "bi-grid" },
  { path: "/orders", label: "My Orders", icon: "bi-receipt" },
  { path: "/admin/orders", label: "All Orders", icon: "bi-clipboard-data", roles: ["admin", "support"] },
];

// onNavigate = called after a click (the Header uses it to close the phone menu)
function Menu({ onNavigate }) {
  const { user } = useAuth();

  // Keep links with no roles, or whose roles include the user's role
  const visibleLinks = MENU_LINKS.filter((link) => !link.roles || (user && link.roles.includes(user.role)));

  return (
    // navbar-nav = Bootstrap's menu list inside a navbar. me-auto pushes the rest to the right
    <ul className="navbar-nav me-auto mb-2 mb-lg-0">
      {visibleLinks.map((link) => (
        <li className="nav-item" key={link.path}>
          {/* NavLink adds "active" to the current page's link (Bootstrap makes it brighter) */}
          <NavLink to={link.path} end={link.path === "/"} className="nav-link" onClick={onNavigate}>
            <i className={`bi ${link.icon} me-1`}></i>
            {link.label}
          </NavLink>
        </li>
      ))}
    </ul>
  );
}

Menu.propTypes = {
  onNavigate: PropTypes.func,
};

export default Menu;





A14. frontend/src/components/layout/Header.jsx

import { useState } from "react";
import { Link, useNavigate } from "react-router-dom";

import Menu from "./Menu.jsx";
import { useAuth } from "../../context/AuthContext.jsx";
import { useToast } from "../../context/ToastContext.jsx";

// Top bar: brand, menu, cart, and the user area. Collapses into ☰ on phones.
function Header() {
  const { user, isLoggedIn, logout } = useAuth();
  const { showToast } = useToast();
  const navigate = useNavigate();
  // Is the phone menu open? (Bootstrap's own script isn't loaded, so React opens/closes it)
  const [menuOpen, setMenuOpen] = useState(false);

  const closeMenu = () => setMenuOpen(false);

  const handleLogout = () => {
    logout();
    closeMenu();
    showToast("You have been logged out.", "info");
    navigate("/login");
  };

  return (
    // navbar-dark = light text. shop-navbar = our navy colour. sticky-top = stays visible when scrolling
    <header className="sticky-top shadow-sm">
      <nav className="navbar navbar-expand-lg navbar-dark shop-navbar">
        <div className="container">
          {/* Brand */}
          <Link to="/" className="navbar-brand fw-bold fs-4" onClick={closeMenu}>
            <i className="bi bi-bag-heart-fill text-warning me-2"></i>
            ABC <span className="text-warning">SHOP</span>
          </Link>

          {/* ☰ button, only visible on small screens */}
          <button
            className="navbar-toggler"
            type="button"
            aria-label="Toggle navigation"
            aria-expanded={menuOpen}
            onClick={() => setMenuOpen(!menuOpen)}
          >
            <span className="navbar-toggler-icon"></span>
          </button>

          {/* "collapse" hides it on phones; adding "show" opens it */}
          <div className={`collapse navbar-collapse ${menuOpen ? "show" : ""}`}>
            <Menu onNavigate={closeMenu} />

            <div className="d-flex flex-wrap align-items-center gap-2">
              {isLoggedIn ? (
                <>
                  {/* Role badge for staff only */}
                  {user.role !== "customer" && (
                    <span className="badge text-bg-warning text-capitalize">{user.role}</span>
                  )}

                  <Link to="/cart" className="btn btn-outline-light btn-sm" onClick={closeMenu}>
                    <i className="bi bi-cart3 me-1"></i>Cart
                  </Link>

                  <Link to="/profile" className="btn btn-link text-light text-decoration-none btn-sm" onClick={closeMenu}>
                    <i className="bi bi-person-circle me-1"></i>
                    {user.name}
                  </Link>

                  <button type="button" className="btn btn-warning btn-sm fw-semibold" onClick={handleLogout}>
                    <i className="bi bi-box-arrow-right me-1"></i>Logout
                  </button>
                </>
              ) : (
                <>
                  <Link to="/cart" className="btn btn-outline-light btn-sm" onClick={closeMenu}>
                    <i className="bi bi-cart3 me-1"></i>Cart
                  </Link>
                  <Link to="/login" className="btn btn-outline-light btn-sm" onClick={closeMenu}>
                    Login
                  </Link>
                  <Link to="/register" className="btn btn-warning btn-sm fw-semibold" onClick={closeMenu}>
                    Register
                  </Link>
                </>
              )}
            </div>
          </div>
        </div>
      </nav>
    </header>
  );
}

export default Header;




